# ================================================================
# SarathiEdTech - Production Environment Configuration Template
# Copy this file to .env for local development.
# Set these variables in Vercel Project Settings for Production.
# ================================================================

# 1. DATABASE CONFIGURATION (PostgreSQL - Supabase / Neon / Railway)
# For Supabase / Neon: Use Connection Pooling URL (Transaction mode, port 6543 or pooled domain)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbooster=true"

# Direct URL for Prisma migrations if using connection pooling (Optional for Supabase/Neon)
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# 2. APPLICATION PUBLIC URL
# Set to your primary domain (e.g., https://sarathiedtech.in or Vercel production URL)
NEXT_PUBLIC_APP_URL="https://sarathiedtech.in"

# 3. ADMIN AUTHENTICATION CREDENTIALS
# Configure secure production email and strong password for Admin Portal access
ADMIN_EMAIL="admin@sarathiedtech.in"
ADMIN_PASSWORD="replace_with_strong_random_production_password"

# 4. SESSION SECURITY SECRET
# Minimum 32-character random string for signing HTTP-only session tokens
JWT_SECRET="replace_with_64_character_hex_or_base64_random_string"
